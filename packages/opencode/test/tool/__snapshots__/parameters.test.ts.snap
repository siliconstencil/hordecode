    "oldString",
    "newString",
  ],
  "type": "object",
}
`;

exports[`tool parameters JSON Schema (wire shape) glob 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "path": {
      "description": "The directory to search in. If not specified, the current working directory will be used. IMPORTANT: Omit this field to use the default directory. DO NOT enter "undefined" or "null" - simply omit it for the default behavior. Must be a valid directory path if provided. External or absolute directories MUST be passed via this field, not embedded in \`pattern\`.",
      "type": "string",
    },
    "pattern": {
      "description": "The glob pattern to match files against (relative glob, e.g. "**/*.ts"). Do not embed an absolute directory in the pattern — pass external/absolute directories via the \`path\` parameter instead; an absolute path in \`pattern\` will be rejected with a clear error.",
      "type": "string",
    },
  },
  "required": [
    "pattern",
  ],
  "type": "object",
}
`;

exports[`tool parameters JSON Schema (wire shape) grep 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "include": {
      "description": "File pattern to include in the search (e.g. "*.js", "*.{ts,tsx}") — relative glob only. Do not embed an absolute directory in \`include\`; pass external/absolute directories via \`path\` instead. An absolute path in \`include\` will be rejected with a clear error.",
      "type": "string",
    },
    "path": {
      "description": "The directory to search in. Defaults to the current working directory. External or absolute directories MUST be passed via this field, not embedded in \`include\`.",
      "type": "string",
    },
    "pattern": {
      "description": "The regex pattern to search for in file contents",
      "type": "string",
    },
  },
  "required": [
    "pattern",
  ],
  "type": "object",
}
`;

