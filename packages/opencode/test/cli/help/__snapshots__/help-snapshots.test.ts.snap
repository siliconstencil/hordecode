// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`horde CLI help-text snapshots every documented command emits stable help text: horde acp --help 1`] = `
"horde acp

start ACP (Agent Client Protocol) server. ACP traffic is stdio NDJSON (JSON-RPC 2.0 over
stdin/stdout); the --port/--hostname flags configure the bundled hordecode HTTP API and do not
expose ACP over a TCP port.

Options:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level                  [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                          [boolean]
      --port         port to listen on                                         [number] [default: 0]
      --hostname     hostname to listen on                           [string] [default: "127.0.0.1"]
      --mdns         enable mDNS service discovery (defaults hostname to 0.0.0.0)
                                                                          [boolean] [default: false]
      --mdns-domain  custom domain name for mDNS service (default: hordecode.local)
                                                               [string] [default: "hordecode.local"]
      --cors         additional domains to allow for CORS                      [array] [default: []]
      --cwd          working directory [string] [default: "<HOME>"]"
`;

exports[`horde CLI help-text snapshots every documented command emits stable help text: horde mcp --help 1`] = `
"horde mcp

manage MCP (Model Context Protocol) servers

Commands:
  horde mcp add [name]     add an MCP server
  horde mcp list           list MCP servers and their status                             [aliases: ls]
  horde mcp auth [name]    authenticate with an OAuth-enabled MCP server
  horde mcp logout [name]  remove OAuth credentials for an MCP server
  horde mcp debug <name>   debug OAuth connection for an MCP server

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

exports[`horde CLI help-text snapshots every documented command emits stable help text: horde attach --help 1`] = `
"horde attach <url>

attach to a running hordecode server

Positionals:
  url  http://localhost:4096                                                     [string] [required]

Options:
  -h, --help          show help                                                            [boolean]
  -v, --version       show version number                                                  [boolean]
      --print-logs    print logs to stderr                                                 [boolean]
      --log-level     log level                 [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure          run without external plugins                                         [boolean]
      --dir           directory to run in                                                   [string]
  -c, --continue      continue the last session                                            [boolean]
  -s, --session       session id to continue                                                [string]
      --fork          fork the session when continuing (use with --continue or --session)  [boolean]
  -p, --password      basic auth password (defaults to HORDECODE_SERVER_PASSWORD or
                      OPENCODE_SERVER_PASSWORD)                                             [string]
  -u, --username      basic auth username (defaults to HORDECODE_SERVER_USERNAME,
                      OPENCODE_SERVER_USERNAME or 'hordecode')                              [string]
      --mini          start the minimal interactive interface             [boolean] [default: false]
      --no-replay     disable mini session history replay on resume and after resize       [boolean]
      --replay-limit  cap visible mini replay to the newest N messages                      [number]"
`;

exports[`horde CLI help-text snapshots every documented command emits stable help text: horde run --help 1`] = `
"horde run [message..]

run hordecode with a message

Positionals:
  message  message to send                                                     [array] [default: []]

Options:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level                  [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                          [boolean]
      --command      the command to run, use message for args                               [string]
  -c, --continue     continue the last session                                             [boolean]
  -s, --session      session id to continue                                                 [string]
      --fork         fork the session before continuing (requires --continue or --session) [boolean]
  -m, --model        model to use in the format of provider/model                           [string]
      --agent        agent to use                                                           [string]
      --format       format: default (formatted) or json (raw JSON events)
                                          [string] [choices: "default", "json"] [default: "default"]
  -f, --file         file(s) to attach to message                                            [array]
      --title        title for the session (uses truncated prompt if no value provided)     [string]
      --attach       attach to a running hordecode server (e.g., http://localhost:4096)     [string]
  -p, --password     basic auth password (defaults to HORDECODE_SERVER_PASSWORD or
                     OPENCODE_SERVER_PASSWORD)                                              [string]
  -u, --username     basic auth username (defaults to HORDECODE_SERVER_USERNAME,
                     OPENCODE_SERVER_USERNAME or 'hordecode')                               [string]
      --dir          directory to run in, path on remote server if attaching                [string]
      --port         port for the local server (defaults to random port if no value provided)
                                                                                            [number]
      --variant      model variant (provider-specific reasoning effort, e.g., high, max, minimal)
                                                                                            [string]
      --thinking     show thinking blocks                                                  [boolean]
  -i, --interactive  run in direct interactive split-footer mode          [boolean] [default: false]
      --auto         auto-approve permissions that are not explicitly denied (dangerous!)
                                                                          [boolean] [default: false]"
`;

exports[`horde CLI help-text snapshots every documented command emits stable help text: horde debug --help 1`] = `
"horde debug

debugging and troubleshooting tools

Commands:
  horde debug config           show resolved configuration
  horde debug lsp              LSP debugging utilities (no-op when all LSPs are disabled; set \`lsp:
                             true\` in config to enable)
  horde debug rg               ripgrep debugging utilities
  horde debug file             file system debugging utilities
  horde debug scrap            list all known projects
  horde debug skill            list all available skills
  horde debug snapshot         snapshot debugging utilities
  horde debug startup          print startup timing
  horde debug agent <name>     show agent configuration details
  horde debug v2               debug v2 catalog and built-in plugins
  horde debug info             show debug information
  horde debug paths            show global paths (data, config, cache, state)
  horde debug wait             wait indefinitely (for debugging)
  horde debug embedding-check  verify memory embedding pipeline in compiled binary

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

