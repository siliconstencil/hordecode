{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "0.1.0",
  "hordecodeBase": "1.19.3",
  "name": "@opencode-ai/core",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "db": "bun drizzle-kit",
    "check:orphaned-tables": "bun run scripts/check-orphaned-tables.ts",
    "migration": "bun run script/migration.ts",
    "fix-node-pty": "bun run script/fix-node-pty.ts",
    "test": "bun test",
    "test:try-best": "HORDECODE_RUN_TRY_BEST_TESTS=1 bun test --no-worker test/session/processor-try-best.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./effect": "./src/effect/index.ts",
    "./effect/layer-node": "./src/effect/layer-node.ts",
    "./history": "./src/history/index.ts",
    "./effect/app-node": "./src/effect/app-node.ts",
    "./auth": "./src/auth/index.ts",
    "./env": "./src/env/index.ts",
    "./npm": "./src/npm/index.ts",
    "./storage": "./src/storage/index.ts",
    "./session": "./src/session/index.ts",
    "./session/runner": "./src/session/runner/index.ts",
    "./system-context": "./src/system-context/index.ts",
    "./*": "./src/*.ts"
  },
  "imports": {
    "#sqlite": {
      "bun": "./src/database/sqlite.bun.ts",
      "node": "./src/database/sqlite.node.ts",
      "default": "./src/database/sqlite.bun.ts"
    },
    "#pty": {
      "bun": "./src/pty/pty.bun.ts",
      "node": "./src/pty/pty.node.ts",
      "default": "./src/pty/pty.bun.ts"
    },
    "#fff": {
      "bun": "./src/filesystem/fff.bun.ts",
      "node": "./src/filesystem/fff.node.ts",
      "default": "./src/filesystem/fff.bun.ts"
    },
    "#read-sqlite": {
      "bun": "./src/storage/read-sqlite.bun.ts",
      "node": "./src/storage/read-sqlite.node.ts",
      "default": "./src/storage/read-sqlite.bun.ts"
    },
    "#db": {
      "bun": "./src/storage/db.bun.ts",
      "node": "./src/storage/db.node.ts",
      "default": "./src/storage/db.bun.ts"
    }
  },
